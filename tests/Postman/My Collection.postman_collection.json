        {
          "name": "Get projects",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Extract the last available project ID\", function () {\r\n    const projects = pm.response.json();\r\n    \r\n    // only projects that have space left\r\n    const availableProjects = projects.filter(p => p.current_volunteers < p.max_volunteers);\r\n    \r\n    if (availableProjects.length > 0) {\r\n        // last project in the filtered array\r\n        const lastProject = availableProjects[0];\r\n        \r\n        // save to the environment\r\n        pm.environment.set(\"available_project_id\", lastProject.id);\r\n        console.log(\"Found last available project ID:\", lastProject.id);\r\n    } else {\r\n        console.log(\"No available projects found to apply to.\");\r\n        pm.expect.fail(\"Setup failed: There are no available projects in the database.\");\r\n    }\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            }
          },
          "response": []
        },
